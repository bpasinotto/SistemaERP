<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
			<section name="SistemaERP.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
		</sectionGroup>
	</configSections>

	<!-- Configurações do ambiente de PRODUÇÃO (usado automaticamente em compilações e publicações Release) -->
	<appSettings>
		<add key="Ambiente" value="Producao" />
		<add key="DesabilitarVerificacaoLicenca" value="false" />
		<add key="UrlApiLicenca" value="https://controlelicencaapi-hvfcfvdyfecpdyfy.centralus-01.azurewebsites.net" />
		<add key="TimeoutLicencaSegundos" value="60" />
	</appSettings>

	<!-- Ajuste as connection strings abaixo para o servidor SQL Server de produção ao implantar -->
	<connectionStrings>
		<add name="SemBanco" connectionString="Server=localhost\SQLEXPRESS;Integrated Security=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
		<add name="ComBanco" connectionString="Server=localhost\SQLEXPRESS;Database=ERPDatabase;Integrated Security=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
	</connectionStrings>

	<userSettings>
		<SistemaERP.Properties.Settings>
			<setting name="Tema" serializeAs="String">
				<value />
			</setting>
		</SistemaERP.Properties.Settings>
	</userSettings>
</configuration>

